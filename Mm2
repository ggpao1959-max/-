-- ฟังก์ชันค้นหาเป้าหมาย
----------------------------------------------------
local function getKnifeTarget()
    local closestTarget = nil
    local shortestDistance = math.huge
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local hrp = plr.Character.HumanoidRootPart
                local dist = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) 
                    and (hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude or 9999
                
                if dist < shortestDistance then
                    shortestDistance = dist
                    closestTarget = hrp
                end
            end
        end
    end
    return closestTarget
end

local function getMurdererTarget()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local role, _ = getRole(plr)
            if role == "Murderer" and hum and hum.Health > 0 then
                return plr.Character.HumanoidRootPart
            end
        end
    end
    return nil
end

local function getSheriffTarget()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local role, _ = getRole(plr)
            if role == "Sheriff" and hum and hum.Health > 0 then
                return plr.Character.HumanoidRootPart
            end
        end
    end
    return nil
end

----------------------------------------------------
-- ระบบ Real Fling Engine (Bypass Physics Engine)
----------------------------------------------------
local function bypassFling(targetHrp)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if not (char and hrp and targetHrp and targetHrp.Parent) then return end

    -- บังคับปิดการชนของตัวเราเพื่อหลบ Anti-cheat เช็คการสแนปตำแหน่ง
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.CustomPhysicalProperties = PhysicalProperties.new(100, 100, 100, 100, 100)
        end
    end

    -- ปรับปรุงแรงหมุนแบบผสมผสาน Velocity Glitch
    local flingVel = Vector3.new(0, 999999, 0)
    local angVel = Vector3.new(999999, 999999, 999999)

    hrp.AssemblyLinearVelocity = flingVel
    hrp.AssemblyAngularVelocity = angVel

    -- เทคนิคการตั้ง CFrame สลับตำแหน่งรอบๆ ตัวเป้าหมาย เพื่อฝืนสร้างแรงกระแทกจากกล่อง Collider
    local targetVel = targetHrp.AssemblyLinearVelocity
    local offset = Vector3.new(math.random(-2, 2), math.random(-1, 1), math.random(-2, 2))
    
    hrp.CFrame = targetHrp.CFrame * CFrame.new(offset) * CFrame.Angles(math.rad(math.random(0, 360)), math.rad(math.random(0, 360)), 0)
    
    -- ใส่แรงดันเสมือนพุ่งเข้าชน
    if targetVel.Magnitude > 0 then
        hrp.AssemblyLinearVelocity = targetVel * 100
    end
end

----------------------------------------------------
-- 1. Silent Aim Hook
----------------------------------------------------
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if (method == "FireServer" or method == "InvokeServer") then
        if gunSilentAimEnabled then
            local murdererHRP = getMurdererTarget()
            if murdererHRP then
                for i, arg in pairs(args) do
                    if type(arg) == "Vector3" then
                        args[i] = murdererHRP.Position
                    elseif typeof(arg) == "CFrame" then
                        args[i] = CFrame.new(arg.Position, murdererHRP.Position)
                    end
                end
                return oldNamecall(self, unpack(args))
            end
        end

        if knifeSilentAimEnabled then
            local targetHRP = getKnifeTarget()
            if targetHRP then
                for i, arg in pairs(args) do
                    if type(arg) == "Vector3" then
                        args[i] = targetHRP.Position
                    elseif typeof(arg) == "CFrame" then
                        args[i] = CFrame.new(arg.Position, targetHRP.Position)
                    end
                end
                return oldNamecall(self, unpack(args))
            end
        end
    end

    return oldNamecall(self, ...)
end)

