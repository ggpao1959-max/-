-- 4. ระบบ Hitbox
----------------------------------------------------
task.spawn(function()
    while true do
        task.wait(0.5)
        
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = plr.Character.HumanoidRootPart
                local role, roleColor = getRole(plr)
                local existingBox = hrp:FindFirstChild("RoleHitbox")

                if hitboxEnabled and role then
                    if not existingBox then
                        existingBox = Instance.new("BoxHandleAdornment")
                        existingBox.Name = "RoleHitbox"
                        existingBox.AlwaysOnTop = true
                        existingBox.ZIndex = 10
                        existingBox.Transparency = 0.5
                        existingBox.Adornee = hrp
                        existingBox.Parent = hrp
                    end
                    existingBox.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                    existingBox.Color3 = roleColor
                else
                    if existingBox then
                        existingBox:Destroy()
                    end
                end
            end
        end

        local droppedGun = getDroppedGun()
        if droppedGun then -- ✅ แก้ไขจุดนี้เรียบร้อยแล้ว (ลบคำว่า me ออก)
            local gunPart = droppedGun:IsA("BasePart") and droppedGun or droppedGun:FindFirstChildWhichIsA("BasePart")
            if gunPart then
                local existingGunBox = gunPart:FindFirstChild("GunHitbox")
                if hitboxEnabled then
                    if not existingGunBox then
                        existingGunBox = Instance.new("BoxHandleAdornment")
                        existingGunBox.Name = "GunHitbox"
                        existingGunBox.Size = Vector3.new(3, 3, 3)
                        existingGunBox.Color3 = Color3.fromRGB(0, 255, 100)
                        existingGunBox.AlwaysOnTop = true
                        existingGunBox.ZIndex = 10
                        existingGunBox.Transparency = 0.4
                        existingGunBox.Adornee = gunPart
                        existingGunBox.Parent = gunPart
                    end
                else
                    if existingGunBox then existingGunBox:Destroy() end
                end
            end
        end
    end
end)

