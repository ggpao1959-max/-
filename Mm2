-- 3. Loop ระบบ Fling อัตโนมัติ (รันใน Heartbeat)
----------------------------------------------------
RunService.Heartbeat:Connect(function()
    if autoFlingEnabled and flingTargetPlayer ~= "" then
        local targetPlr = Players:FindFirstChild(flingTargetPlayer)
        if targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") then
            bypassFling(targetPlr.Character.HumanoidRootPart)
        end
    end

    if shakeMurdererEnabled then
        local mHrp = getMurdererTarget()
        if mHrp then
            bypassFling(mHrp)
        end
    end

    if shakeSheriffEnabled then
        local sHrp = getSheriffTarget()
        if sHrp then
            bypassFling(sHrp)
        end
    end
end)

