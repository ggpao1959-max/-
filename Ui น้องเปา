-- 5. สร้างปุ่มมุมขวาล่างสำหรับปรับขนาด (Resize Handle)
----------------------------------------------------
local resizeHandle = Instance.new("TextButton")
resizeHandle.Name = "ResizeHandle"
resizeHandle.Size = UDim2.new(0, 25, 0, 25)
resizeHandle.Position = UDim2.new(1, -25, 1, -25)
