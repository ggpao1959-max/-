end)

----------------------------------------------------
-- ระบบฟังก์ชั่นสร้าง Drag (ลากย้ายตำแหน่ง UI)
----------------------------------------------------
local function enableDrag(targetElement, moveElement)
    local dragging = false
    local dragStart, startPos

    targetElement.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = moveElement.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            moveElement.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- เปิดใช้งานการลากย้ายหน้าต่างหลัก (MainFrame)
enableDrag(headerBar, frame)

----------------------------------------------------
-- ระบบลากปุ่มวงกลม (Drag) + แยกแยะการเปิด/ปิด UI
----------------------------------------------------
local btnDragging = false
local btnDragStart, btnStartPos
local isMoved = false

toggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        btnDragging = true
        isMoved = false
        btnDragStart = input.Position
        btnStartPos = toggleButton.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if btnDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - btnDragStart
        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
            isMoved = true
        end
        toggleButton.Position = UDim2.new(
            btnStartPos.X.Scale,
            btnStartPos.X.Offset + delta.X,
            btnStartPos.Y.Scale,
            btnStartPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        btnDragging = false
    end
end)

toggleButton.Activated:Connect(function()
    if not isMoved then
        frame.Visible = not frame.Visible
    end
end)
