local function createESP(plr)
	if plr == player then return end
	local char = plr.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = plr.Name .. "_ESP_Highlight"
	highlight.Adornee = char
	highlight.FillColor = Color3.fromRGB(255, 50, 50)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.5
	highlight.Parent = espFolder

	local bill = Instance.new("BillboardGui")
	bill.Name = plr.Name .. "_ESP_Bill"
	bill.Adornee = hrp
	bill.Size = UDim2.new(0, 150, 0, 40)
	bill.StudsOffset = Vector3.new(0, 3.5, 0)
	bill.AlwaysOnTop = true
	bill.Parent = espFolder

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	lbl.TextStrokeTransparency = 0
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 12
	lbl.Parent = bill

	local conn
	conn = RunService.RenderStepped:Connect(function()
		if showESP and highlight.Parent and hum and hum.Parent then
			lbl.Text = plr.Name .. "\nHP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
		else
			conn:Disconnect()
			highlight:Destroy()
			bill:Destroy()
		end
	end)
end

local function toggleESP()
	showESP = not showESP
	espBtn.Text = showESP and "มองทะลุ (ESP): เปิด" or "มองทะลุ (ESP): ปิด"
	espBtn.BackgroundColor3 = showESP and Color3.fromRGB(0, 170, 90) or Color3.fromRGB(210, 70, 70)
	clearESP()
	if showESP then
		for _, plr in ipairs(Players:GetPlayers()) do
			createESP(plr)
		end
	end
end

local function resetHitboxes()
	for plr, size in pairs(originalSizes) do
		if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = plr.Character.HumanoidRootPart
			hrp.Size = size
			hrp.Transparency = 1
			hrp.CanCollide = true
		end
	end
	table.clear(originalSizes)
end

