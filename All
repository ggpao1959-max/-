-- PERFECT GOD-MODE SAFE RETURN FLING LOGIC (2 SECONDS)
----------------------------------------------------
local function stopFling()
	if not flinging then return end
	flinging = false

	if flingConnection then
		flingConnection:Disconnect()
		flingConnection = nil
	end

	if character and root and humanoid then
		-- 1. Anchor ทันทีเพื่อหยุดฟิสิกส์ทั้งหมดชั่วคราว
		root.Anchored = true

		-- 2. ย้ายตัวละครกลับตำแหน่งเดิมอย่างปลอดภัย (ยอยสูงขึ้นนิดหน่อยเพื่อป้องกันติดพื้น)
		if originalCFrame then
			character:PivotTo(originalCFrame + Vector3.new(0, 3, 0))
			originalCFrame = nil
		end

		-- 3. เคลียร์ค่าความเร็วและแรงเหวี่ยงตกค้างของทุก Part ในตัวละคร
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
				part.Velocity = Vector3.zero
				part.RotVelocity = Vector3.zero
				part.CanTouch = false
				part.CanCollide = false
			end
		end

		-- 4. Multi-Frame Physics Flush Loop (หน่วงเวลาล้างค่าความเร็ว 8 เฟรม ให้ Server และ Engine ปรับตัว)
		task.spawn(function()
			for i = 1, 8 do
				RunService.Heartbeat:Wait()
				if character and root then
					for _, part in ipairs(character:GetDescendants()) do
						if part:IsA("BasePart") then
							part.AssemblyLinearVelocity = Vector3.zero
							part.AssemblyAngularVelocity = Vector3.zero
							part.CanTouch = false
							part.CanCollide = false
						end
					end
				end
			end

			-- 5. คืนค่าการชนและสถานะตัวละครอย่างปลอดภัย 100% ไม่ให้ตัวตาย
			if character and root and humanoid and humanoid.Health > 0 then
				for _, part in ipairs(character:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = true
						part.CanTouch = true
					end
				end

				root.Anchored = false
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)
	end

	flingBtn.Text = "💥 ปริ้วคนนี้ (Fling 2B Power)"
	flingBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
end

local function startFling(target)
	if flinging or not root or not target or not target.Character then return end
	local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
	if not targetRoot or not humanoid or humanoid.Health <= 0 then return end

	flinging = true
	originalCFrame = root.CFrame -- บันทึกตำแหน่งก่อนวาปไปปั่น

	-- ปิดการตายฝั่ง Client ชั่วคราวเพื่อป้องกันการกระแทกแล้วล้มตาย
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)

	flingBtn.Text = "💥 กำลังอัดแรง 2 พันล้าน (2 วิ)..."
	flingBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)

	local startTime = os.clock()
	local angle = 0
	local flingPower = 2000000000 -- แรงอัดมหาศาล 2,000,000,000

	flingConnection = RunService.PostSimulation:Connect(function()
		if not flinging or not root or not root.Parent or not targetRoot or not targetRoot.Parent or not humanoid or humanoid.Health <= 0 then
			stopFling()
			return
		end

		-- ปิด Collision & Touch ชั่วคราว ป้องกันการโดน KillBrick หรือแรงสะท้อนกระแทกตัวตาย
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
				part.CanTouch = false
			end
		end

		-- ตรวจสอบระยะความสูง ป้องกันการตกหลุด FallenPartsDestroyHeight ของแมพ
		local minSafeY = Workspace.FallenPartsDestroyHeight + 100
		if root.Position.Y <= minSafeY or targetRoot.Position.Y <= minSafeY then
			stopFling()
			return
		end

		-- หมุนปั่น CFrame แนบติดตัวเป้าหมายอย่างสมบูรณ์
		angle = (angle + 100) % 360
		local offset = Vector3.new(
			math.sin(angle) * 0.05,
			(math.random() - 0.5) * 0.1,
			math.cos(angle) * 0.05
		)

		local newCFrame = targetRoot.CFrame * CFrame.new(offset) * CFrame.Angles(
			math.rad(math.random(-180, 180)),
			math.rad(math.random(-180, 180)),
			math.rad(math.random(-180, 180))
		)
		character:PivotTo(newCFrame)

		-- อัดแรงเหวี่ยง 2 พันล้านส่งเป้าหมายให้บินกระเด็น
		root.AssemblyLinearVelocity = Vector3.new(
			(math.random() - 0.5) * flingPower,
			flingPower,
			(math.random() - 0.5) * flingPower
		)
		root.AssemblyAngularVelocity = Vector3.new(flingPower, flingPower, flingPower)

		-- ปั่นเต็มกำลัง 2.0 วินาทีแล้วทำการดึงกลับตำแหน่งเดิมอย่างปลอดภัย
		if os.clock() - startTime > 2.0 then
			stopFling()
		end
	end)
end

