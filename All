	soulBtn.BackgroundColor3 = soulOut and Color3.fromRGB(0, 170, 90) or Color3.fromRGB(210, 70, 70)

	if soulOut then
		if root then
			soulCam = Instance.new("Part")
			soulCam.Size = Vector3.new(1, 1, 1)
			soulCam.Transparency = 1
			soulCam.CanCollide = false
			soulCam.Anchored = true
			soulCam.CFrame = root.CFrame
			soulCam.Parent = Workspace
			
			camera.CameraSubject = soulCam
			root.Anchored = true
		end
	else
		if soulCam then soulCam:Destroy() soulCam = nil end
		if root then root.Anchored = false end
		if humanoid then camera.CameraSubject = humanoid end
	end
end

