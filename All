	if humanoid then humanoid.PlatformStand = false end
	flyBtn.Text = "บิน (Fly): ปิด"
	flyBtn.BackgroundColor3 = Color3.fromRGB(210, 70, 70)
end

local function startFly()
	if flying or not root then return end
	flying = true

	local att = Instance.new("Attachment")
	att.Name = "FlyAttachment"
	att.Parent = root

	flyVel = Instance.new("LinearVelocity")
	flyVel.MaxForce = 9e9
	flyVel.VectorVelocity = Vector3.zero
	flyVel.Attachment0 = att
	flyVel.RelativeTo = Enum.ActuatorRelativeTo.World
	flyVel.Parent = root

	flyAlign = Instance.new("AlignOrientation")
	flyAlign.MaxTorque = 9e9
	flyAlign.Responsiveness = 200
	flyAlign.Mode = Enum.OrientationAlignmentMode.OneAttachment
	flyAlign.Attachment0 = att
	flyAlign.Parent = root

	if humanoid then humanoid.PlatformStand = true end
	flyBtn.Text = "บิน (Fly): เปิด"
	flyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 90)
end

