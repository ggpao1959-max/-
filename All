-- HELPER: GET INPUT VECTOR
----------------------------------------------------
local function getRawInputVector()
	if Controls then
		local cVec = Controls:GetMoveVector()
		if cVec and cVec.Magnitude > 0.05 then
			return Vector3.new(cVec.X, 0, cVec.Z)
		end
	end

	local x, z = 0, 0
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then z = z - 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then z = z + 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then x = x - 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then x = x + 1 end

	if x == 0 and z == 0 and humanoid and humanoid.MoveDirection.Magnitude > 0.05 then
		local localDir = camera.CFrame:VectorToObjectSpace(humanoid.MoveDirection)
		return Vector3.new(localDir.X, 0, localDir.Z)
	end

	return Vector3.new(x, z)
end

local function getCameraRelativeMove()
	local inputVec = getRawInputVector()
	local y = 0

	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then y = y + 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then y = y - 1 end

	if inputVec.Magnitude > 0.05 or y ~= 0 then
		local worldDir = camera.CFrame:VectorToWorldSpace(inputVec) + Vector3.new(0, y, 0)
		return worldDir
	end

	return Vector3.zero
end

