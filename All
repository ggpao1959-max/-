RunService.RenderStepped:Connect(function(dt)
	if not character or not root or not humanoid then return end

	if flying and flyVel and flyAlign then
		local moveDir = getCameraRelativeMove()
		if moveDir.Magnitude > 0 then
			flyVel.VectorVelocity = moveDir.Unit * speed
		else
			flyVel.VectorVelocity = Vector3.zero
		end
		flyAlign.CFrame = camera.CFrame
	end

	if soulOut and soulCam then
		local moveDir = getCameraRelativeMove()
		soulCam.CFrame = soulCam.CFrame + (moveDir * speed * dt)
	end
end)

RunService.Stepped:Connect(function()
	if not character or not root or not humanoid then return end

	if humanoid.WalkSpeed ~= walkSpeedVal and walkSpeedVal ~= 16 then
		humanoid.WalkSpeed = walkSpeedVal
	end

	if noclip then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end

	if showHitbox then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
				local hrp = plr.Character.HumanoidRootPart
				if not originalSizes[plr] then
					originalSizes[plr] = hrp.Size
				end
				hrp.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
				hrp.Transparency = 0.7
				hrp.Color = Color3.fromRGB(255, 0, 100)
				hrp.Material = Enum.Material.ForceField
				hrp.CanCollide = false
			end
		end
	end

	if wallWalk and not flying then
		local rayParams = RaycastParams.new()
		rayParams.FilterDescendantsInstances = {character}
		rayParams.FilterType = Enum.RaycastFilterType.Exclude

		local rayResult = Workspace:Raycast(root.Position, root.CFrame.LookVector * 4, rayParams) 
			or Workspace:Raycast(root.Position, camera.CFrame.LookVector * 4, rayParams)

		if rayResult then
			if not wallVel then
				wallVel = Instance.new("BodyVelocity")
				wallVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
				wallVel.Parent = root
			end
			local verticalMove = 0
			if UserInputService:IsKeyDown(Enum.KeyCode.W) or (humanoid.MoveDirection.Magnitude > 0) then
				verticalMove = speed / 1.5
			end
			wallVel.Velocity = Vector3.new(0, verticalMove, 0) - (rayResult.Normal * 10)
		else
			if wallVel then
				wallVel:Destroy()
				wallVel = nil
			end
		end
	end
end)

