-- ฟังก์ชันหลักในการวิ่งฟาร์มแบบวาปความเร็วพอดีๆ
local function autoFarm(currentRun)
    local Character = LocalPlayer.Character
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
    
    local NormalStages = Workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")

    -- วาปผ่านด่านต่างๆ ทั้ง 10 ด่านด้วยความเร็วที่เสถียรขึ้น
    for i = 1, 10 do
        if not getgenv().TreasureAutoFarm.Enabled then break end
        local Stage = NormalStages:FindFirstChild("CaveStage" .. i)
        if Stage then
            local DarknessPart = Stage:FindFirstChild("DarknessPart")
            if DarknessPart then
                Character.HumanoidRootPart.CFrame = DarknessPart.CFrame
                
                -- สร้างบล็อกกันตกชั่วคราว
                local Part = Instance.new("Part", Character)
                Part.Anchored = true
                Part.Position = Character.HumanoidRootPart.Position - Vector3.new(0, 6, 0)
                
                task.wait(getgenv().TreasureAutoFarm.Teleport)
                Part:Destroy()
            end
        end
    end

    -- วาปไปที่กล่องสมบัติท้ายแมพเพื่อรับรางวัล
    while getgenv().TreasureAutoFarm.Enabled do
        task.wait()
        if Character and Character:FindFirstChild("HumanoidRootPart") and NormalStages:FindFirstChild("TheEnd") then
            local chest = NormalStages.TheEnd:FindFirstChild("GoldenChest")
            if chest and chest:FindFirstChild("Trigger") then
                Character.HumanoidRootPart.CFrame = chest.Trigger.CFrame
            end
        end
        if Lighting.ClockTime ~= 14 then break end
    end

    -- รอจนกว่าตัวละครจะเกิดใหม่เพื่อเริ่มรอบถัดไป
    local Respawned = false
    local Connection
    Connection = LocalPlayer.CharacterAdded:Connect(function()
        Respawned = true
        Connection:Disconnect()
    end)
    
    repeat task.wait() until Respawned or not getgenv().TreasureAutoFarm.Enabled
    task.wait(getgenv().TreasureAutoFarm.TimeBetweenRuns)
end

-- รันลูปออโต้ฟาร์มแบบแยก Thread
task.spawn(function()
    local autoFarmRun = 1
    while task.wait(1) do
        if getgenv().TreasureAutoFarm.Enabled then
            pcall(function()
                autoFarm(autoFarmRun)
            end)
            autoFarmRun = autoFarmRun + 1
        end
    end
end)


