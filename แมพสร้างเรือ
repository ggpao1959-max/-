    Teleport = 1.3,           -- ปรับความเร็วในการวาปให้ช้าลงกำลังดี (1.3 วินาที) มั่นใจว่าโหลดด่านทันแบบสมบูรณ์ 100%
    TimeBetweenRuns = 4.5     -- เวลารอเริ่มรอบใหม่หลังจากรับรางวัล
}

