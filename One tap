-- Slider FOV Size Logic
local isDraggingFov = false
local function updateFovSlider(input)
    local sliderPos = sliderBg.AbsolutePosition.X
    local sliderWidth = sliderBg.AbsoluteSize.X
    local scale = math.clamp((input.Position.X - sliderPos) / sliderWidth, 0, 1)
    
    sliderFill.Size = UDim2.new(scale, 0, 1, 0)
    sliderKnob.Position = UDim2.new(scale, -10, 0.5, -10)
    
    fovRadius = math.floor(minFov + (scale * (maxFov - minFov)))
    titleText.Text = "🎯 วงกลมล็อคเป้า (ขนาด: " .. tostring(fovRadius) .. ")"
end

sliderKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingFov = true
    end
end)

-- Slider Smoothness Speed Logic
local isDraggingSmooth = false
local function updateSmoothSlider(input)
    local sliderPos = smoothSliderBg.AbsolutePosition.X
    local sliderWidth = smoothSliderBg.AbsoluteSize.X
    local scale = math.clamp((input.Position.X - sliderPos) / sliderWidth, 0, 1)
    
    smoothSliderFill.Size = UDim2.new(scale, 0, 1, 0)
    smoothSliderKnob.Position = UDim2.new(scale, -10, 0.5, -10)
    
    aimbotSmoothness = minSmooth + (scale * (maxSmooth - minSmooth))
    local percent = math.floor(scale * 100)
    if percent >= 98 then
        smoothText.Text = "⚡ ความเร็วการหันกล้อง: 100% (Instant)"
    else
        smoothText.Text = "⚡ ความเร็วการหันกล้อง: " .. tostring(percent) .. "% (Smooth)"
    end
end

smoothSliderKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSmooth = true
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if isDraggingFov then
            updateFovSlider(input)
        elseif isDraggingSmooth then
            updateSmoothSlider(input)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingFov = false
        isDraggingSmooth = false
    end
end)

toggleButton.Activated:Connect(function()
    mainFrame.Visible = not mainFrame.Visible
end)
